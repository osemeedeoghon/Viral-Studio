# ---------------------------------------------------------------
# Viral — self-hosted short-form video studio
# Copy to .env and fill in what you need. Only ANTHROPIC_API_KEY is required.
# ---------------------------------------------------------------

PORT=8000

# Protects the dashboard with HTTP basic auth (username: admin). Strongly recommended
# on a public server, since the dashboard can publish to your social accounts.
APP_PASSWORD=
# Used to sign public media links (Instagram/TikTok/D-ID fetch videos from these). Set to a long random string.
SECRET_KEY=change-me-to-a-long-random-string
# Public https URL of this server, e.g. https://viral.example.com (needed for Instagram, D-ID and YouTube OAuth).
PUBLIC_BASE_URL=http://localhost:8000

# --- AI (scripts, highlight detection, titles) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Transcription (runs locally with faster-whisper) ---
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Voiceover ---
# kokoro (local, free, runs in the kokoro container) | elevenlabs
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- AI presenter (talking person) ---
# photo       : animates the presenter photo you upload (gentle motion, no lip-sync)
# did         : D-ID talking-head API (real lip-sync; needs PUBLIC_BASE_URL reachable from the internet)
# lipsync_http: your own self-hosted lip-sync server (SadTalker / LatentSync / MuseTalk wrapper) — see README
AVATAR_PROVIDER=photo
DID_API_KEY=
LIPSYNC_URL=

# --- B-roll stock footage (free key at pexels.com/api) ---
PEXELS_API_KEY=

# --- Publishing ---
# YouTube: create an OAuth "Web application" client in Google Cloud with redirect URI
#   {PUBLIC_BASE_URL}/api/oauth/youtube/callback  then click "Connect YouTube" in Settings.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok Content Posting API user access token (scope video.publish).
TIKTOK_ACCESS_TOKEN=
# Unaudited TikTok apps can only post privately: SELF_ONLY. After audit: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Instagram Graph API (Business/Creator account linked to a Facebook Page).
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
